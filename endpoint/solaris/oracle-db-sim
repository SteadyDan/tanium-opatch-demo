#!/bin/sh
# SMF method for svc:/application/oracle-db-sim. Pure Bourne syntax (Solaris 10
# runs methods with /bin/sh). Contract model: start a long-lived child that
# stands in for the oracle and tnslsnr processes, then return; ':kill' stops it.
. /lib/svc/share/smf_include.sh
ORACLE_HOME=/u01/app/oracle/product/19/dbhome_1; export ORACLE_HOME

case "$1" in
  start)
    echo "oracle-db-sim starting, ORACLE_HOME=$ORACLE_HOME"
    ( while :; do sleep 60; done ) &
    exit $SMF_EXIT_OK
    ;;
  *)
    echo "usage: $0 start"
    exit $SMF_EXIT_ERR_CONFIG
    ;;
esac
