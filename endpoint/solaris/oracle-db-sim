#!/bin/sh
# SMF method for svc:/application/oracle-db-sim. Contract-model service:
# start a long-lived child (stands in for the oracle and tnslsnr processes)
# and return; SMF tracks the contract and ':kill' stops it.
. /lib/svc/share/smf_include.sh

case "$1" in
  start)
    echo "oracle-db-sim starting as $(id -un), ORACLE_HOME=${ORACLE_HOME:-unset}"
    ( while :; do sleep 60; done ) &
    exit "$SMF_EXIT_OK"
    ;;
  *)
    echo "usage: $0 start"
    exit "$SMF_EXIT_ERR_CONFIG"
    ;;
esac
